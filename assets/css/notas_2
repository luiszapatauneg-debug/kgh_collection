                    if (!p.categoria) return false;
                    const catProd = p.categoria.toLowerCase().trim();

                    // 1. Si son exactamente iguales (ej: "dama-chaquetas" === "dama-chaquetas")
                    if (catProd === catLimpia) return true;

                    // 2. Si la categoría del producto empieza con la categoría de la URL o viceversa (ej: "dama" abarca "dama-chaquetas")
                    if (catProd.startsWith(catLimpia + "-") || catLimpia.startsWith(catProd + "-")) return true;

                    // 3. Si una contiene a la otra (ej: "dama-chaquetas" contiene "chaqueta")
                    if (catProd.includes(catLimpia) || catLimpia.includes(catProd)) return true;

